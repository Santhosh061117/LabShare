# LabShare Backend Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Local Storage Directory (defaults to ~/.labshare or ./data)
# On Termux, you can use: /data/data/com.termux/files/home/.labshare
# Or external storage: /sdcard/LabShare
LABSHARE_DATA_DIR=

# Security
JWT_SECRET=replace-with-a-random-secure-secret-key-32-chars-min

# Allowed CORS Origin (use * or your GitHub Pages URL, e.g. https://santhosh061117.github.io)
CORS_ORIGIN=*

# File Limits
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE_MB=5

# Session Lifetimes (days)
SESSION_EXPIRY_DAYS=30
TRUSTED_DEVICE_EXPIRY_DAYS=180
