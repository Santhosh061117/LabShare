{
  "name": "labshare",
  "version": "1.0.0",
  "description": "Self-hosted communication and file-sharing platform designed for college labs on Android Termux",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "setup": "bash ./setup.sh",
    "start": "bash ./start.sh",
    "stop": "bash ./stop.sh",
    "status": "bash ./status.sh",
    "restart": "bash ./restart.sh"
  },
  "keywords": [
    "labshare",
    "termux",
    "android",
    "cloudflare-tunnel",
    "file-sharing",
    "college-lab",
    "websocket",
    "pwa"
  ],
  "author": "Santhosh061117",
  "license": "MIT"
}
