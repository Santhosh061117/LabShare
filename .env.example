# LabShare Root Environment Template
# Copy this to backend/.env and configure your values

# Server Port
PORT=3000
HOST=0.0.0.0

# Optional: Cloudflare Zero Trust Tunnel Token (if using token-based tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=

# JWT Secret for Session Hashing (automatically generated by ./setup.sh)
JWT_SECRET=generate-a-secure-random-token-here

# CORS Origin (allow all or specify your GitHub Pages URL)
CORS_ORIGIN=*

# Storage Directory (default: ~/.labshare or ./data)
# In Termux: /data/data/com.termux/files/home/.labshare
LABSHARE_DATA_DIR=

# File Limits
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE_MB=5

# Session Durations
SESSION_EXPIRY_DAYS=30
TRUSTED_DEVICE_EXPIRY_DAYS=180
